#!/bin/sh
# The two checks CI runs that a laptop can run in seconds: the typecheck, and clippy with every
# warning an error. `pnpm install` points core.hooksPath here through the prepare script.
set -e
cd "$(git rev-parse --show-toplevel)"
pnpm typecheck
cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings
