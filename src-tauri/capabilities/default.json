{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions the one window needs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute"
  ]
}
