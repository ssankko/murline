{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Piano",
  "version": "0.1.0",
  "identifier": "com.piano.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm vite"
  },
  "app": {
    "windows": [
      {
        "title": "Piano",
        "width": 1400,
        "height": 1000
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
