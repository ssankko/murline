{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Murline",
  "version": "0.1.1",
  "identifier": "com.ssankko.murline",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm vite"
  },
  "app": {
    "windows": [
      {
        "title": "Murline",
        "width": 1400,
        "height": 1000,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 26 }
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ssankko/murline/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NzRDQ0REOEJDQjAxNTYKUldSV0FjdUwzY3gwcEtjakRVY1RlWmNxUndXa0Z1OUljMlNadHZhSEQ5WEZRbEhHbXI1YVFLdmgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
